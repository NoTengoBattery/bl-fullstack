
# Rails dev server networking overrides for Docker
HOST=0.0.0.0

# Vite dev server + HMR endpoints
VITE_DEV_SERVER_HOST=0.0.0.0
VITE_DEV_SERVER_PORT=3036
VITE_HMR_HOST=0.0.0.0
VITE_HMR_PORT=3036
VITE_HMR_PROTOCOL=ws

# Thread, pool and puma tuning for development
CACHE_POOL_SIZE=3
DATABASE_POOL_SIZE=5
KVDATABASE_POOL_SIZE=2
PUMA_WORKER_CHECK_INTERVAL=1
PUMA_WORKER_TIMEOUT=3
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=0
