{
    "dependencies": {
        "@inertiajs/react": "^2.2",
        "@tailwindcss/forms": "^0.5",
        "@tailwindcss/typography": "^0.5",
        "@tailwindcss/vite": "^4.1",
        "lucide-react": "^0.556",
        "react": "^19.2",
        "react-dom": "^19.2",
        "tailwindcss": "^4.1"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3",
        "@eslint/js": "^9.39",
        "@types/node": "^24.10",
        "@types/react": "^19.2",
        "@types/react-dom": "^19.2",
        "@typescript-eslint/eslint-plugin": "^8.48",
        "@typescript-eslint/parser": "^8.48",
        "@vitejs/plugin-react": "^5.1",
        "eslint": "^9.39",
        "eslint-config-prettier": "^10.1",
        "eslint-plugin-prettier": "^5.5",
        "eslint-plugin-react": "^7.37",
        "eslint-plugin-react-hooks": "^7.0",
        "husky": "^9.1",
        "prettier": "^3.7",
        "typescript": "^5.9",
        "vite": "^7.2",
        "vite-plugin-ruby": "^5.1"
    },
    "engines": {
        "node": "24.x"
    },
    "name": "ballast-lane",
    "private": true,
    "scripts": {
        "check": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
        "format:check": "prettier --check 'app/frontend/**/*.{js,ts,jsx,tsx,css,scss,json,md,html}'",
        "format": "prettier --write 'app/frontend/**/*.{js,ts,jsx,tsx,css,scss,json,md,html}'",
        "lint:js:fix": "eslint 'app/frontend/**/*.{js,ts,jsx,tsx}' --fix",
        "lint:js": "eslint 'app/frontend/**/*.{js,ts,jsx,tsx}' --max-warnings=0",
        "prepare": "husky"
    },
    "version": "1.0.0"
}