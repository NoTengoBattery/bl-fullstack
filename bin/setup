#!/usr/bin/env ruby
# frozen_string_literal: true

require 'fileutils'

# path to your application root.
APP_ROOT = File.expand_path('..', __dir__)

TEST_ENVIRONMENT = ['test'].include?(ENV.fetch('RAILS_ENV', nil))
CI_PIPELINE = TEST_ENVIRONMENT && ENV.fetch('CI', nil)
DROP_TO_SHELL = (ENV['DROP_TO_SHELL'] == 'true')
LOCAL_ENVIRONMENTS = [nil, 'development', 'test'].include?(ENV.fetch('RAILS_ENV', nil))
LOCAL_PIPELINE = TEST_ENVIRONMENT && !ENV['CI']
%w[backend migration sidekiq webhook worker].each do |service|
  Object.const_set(service.upcase.to_sym, ENV['SERVICE_NAME'] == service)
end

def system!(*args)
  return if system(*args)

  system('unset DROP_TO_SHELL; zsh') if LOCAL_ENVIRONMENTS && DROP_TO_SHELL && !CI_PIPELINE
  abort("\n== Command #{args} failed ==")
end

FileUtils.chdir(APP_ROOT) do
  # This script is a way to set up or update your development environment automatically.
  # This script is idempotent, so that you can run it at any time and get an expectable outcome.
  # Add necessary setup steps to this file.

  puts '== Installing dependencies =='
  system('mkdir -p ~/.tmp')
  system('bundle check') || system!('TMPDIR=~/.tmp bundle install')
  system('pnpm install --frozen-lockfile') || system!('pnpm install')

  # puts "\n== Copying sample files =="
  # unless File.exist?("config/database.yml")
  #   FileUtils.cp "config/database.yml.sample", "config/database.yml"
  # end

  if LOCAL_ENVIRONMENTS && !CI_PIPELINE
    puts "\n== Removing old logs and tempfiles =="
    system! 'bin/rails log:clear tmp:clear'
  end

  puts "\n== Preparing database =="
  if TEST_ENVIRONMENT
    system! 'bin/rails db:drop'
    system 'rm -f db/*schema.rb'
    puts "\n~~> The test database was dropped and the schema file deleted"
  end
  if LOCAL_ENVIRONMENTS || MIGRATION
    system! "SKIP_SEEDS=#{TEST_ENVIRONMENT} DATABASE_LOCK_TIMEOUT=0 bin/rails db:prepare db:migrate"
  end
  system! 'bin/rails db:seed' unless TEST_ENVIRONMENT || MIGRATION

  if (!LOCAL_ENVIRONMENTS && !(MIGRATION || SIDEKIQ || WEBHOOK)) || CI_PIPELINE
    if CI_PIPELINE
      # puts "\n== Precompiling assets and generating ES indexes =="
      # system! "bin/rails assets:precompile"
      # system! "bin/rails searchkick:reindex:all"
    else
      # puts "\n== Precompiling assets =="
      # spawn "bin/rails assets:precompile"
    end
  end

  puts "\n== Setup script: done! =="
end
